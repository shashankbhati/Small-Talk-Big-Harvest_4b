DATABASE_URL=sqlite:///./data/small_talk.db
STORAGE_BACKEND=local            # local | minio
AUDIO_DIR=./data/audio
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=voices
# Speech-to-text: primary, then local fallback (faster-whisper on this machine)
STT_PROVIDER=together           # together | local
STT_FALLBACK=local              # local | (empty = no fallback)
TOGETHER_STT_MODEL=openai/whisper-large-v3
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda             # cuda | cpu  (cuda falls back to cpu automatically)
WHISPER_COMPUTE=                # empty = auto (int8_float16 on cuda, int8 on cpu)
WHISPER_PRELOAD=false           # true = load local whisper at startup (first fallback is faster)

# LLM used ONLY for symptom extraction (never writes advice)
LLM_PROVIDER=together            # together | ollama
LLM_FALLBACK=ollama              # ollama | (empty = no fallback)
TOGETHER_TIMEOUT=20
TOGETHER_RETRIES=1               # extra tries on timeouts / 429 / 5xx before falling back
TOGETHER_API_KEY=
TOGETHER_URL=https://api.together.xyz/v1
TOGETHER_MODEL=Qwen/Qwen3.5-9B
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_THINK=                    # set false for thinking models (qwen3)
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192              # extraction prompt is ~4.3k tokens; 4096 would truncate it
LLM_TIMEOUT=300                  # seconds Ollama may take per request
WEATHER_ENABLED=true             # past weather at the farm nudges the match (Open-Meteo, no key); config/weather.yaml
WEATHER_TIMEOUT=8
MODEL_LOG_DIR=./data/logs          # JSON lines: every STT/LLM call (input, output, latency) + case; empty = off
LEXICON_CHECK=always             # always | local (only the Ollama fallback) | off

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE=true
PUBLIC_BASE_URL=http://localhost:8000   # your ngrok https URL (ngrok http 8000), no trailing slash; BASE_URL also works
NGROK_AUTHTOKEN=                        # set = server opens the ngrok tunnel itself and sets PUBLIC_BASE_URL
NGROK_DOMAIN=                           # optional static ngrok domain (Twilio webhook stays the same)
PHONE_SALT=change-me
FERNET_KEY=                       # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FARMER_LANGUAGE=hi                # call language for farmers registered in the app (they skip the language menu)
DEFAULT_COUNTRY_CODE=+91          # added to numbers the app sends without "+"
CORS_ORIGINS=*                    # comma-separated origins of the registration app
REVIEW_USER=expert
REVIEW_PASSWORD=change-me
ASR_MIN_CONF=0.45
MIN_KNOWN=2
SCORE_MIN=0.75
MARGIN_MIN=0.15
RETENTION_DAYS=365
VOICE_MAX_TRIES=100              # call polls every 3 s (~5 min) before saying 'not sure'
