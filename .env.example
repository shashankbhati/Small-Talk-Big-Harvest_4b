# Copy this file to .env and fill in the values.

# --- Twilio (console.twilio.com -> Account Info) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Delete the caller's recording from Twilio right after we transcribe it (privacy: no voice stored)
DELETE_RECORDINGS=true

# --- Public URL of this server (your ngrok https URL, no trailing slash) ---
BASE_URL=https://xxxx.ngrok-free.app

# --- Speech recognition (faster-whisper) ---
WHISPER_MODEL=small
# Language code for the caller, e.g. en, sw, hi, kn. Leave empty for auto-detect.
ASR_LANGUAGE=en

# --- Small local LLM via Ollama (feature extraction only) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Demo location used when the caller is not in the farmer registry ---
# Default: Kodagu (Coorg), Karnataka, India - a smallholder coffee region
DEMO_LAT=12.42
DEMO_LON=75.74
DEMO_VILLAGE=Demo village

# --- Decision thresholds ---
CONFIDENCE_THRESHOLD=0.60
MARGIN_THRESHOLD=0.20
MIN_KNOWN_FEATURES=2

# Salt for hashing phone numbers (we never store raw numbers)
PHONE_HASH_SALT=change-me
